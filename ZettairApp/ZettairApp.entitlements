<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        com.apple.security.application-groups removed for the side-load
        build because free Apple ID accounts can't register App Groups
        in the developer portal. Re-add when on a paid Developer Program.

        com.apple.developer.associated-domains is also removed because
        Universal Links require a paid account + the AASA file on
        zettair.io. Tapping zettair.io/?q=... in Safari falls back to
        opening the website, which is fine for side-load testing.
    -->
</dict>
</plist>
